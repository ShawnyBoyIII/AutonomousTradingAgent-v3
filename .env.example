# Trading Bot Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# Paths
CONFIG_PATH=config.yaml
STATE_DB_PATH=state/trading_bot.db
LOG_LEVEL=INFO

# Optional alerts
DISCORD_WEBHOOK_URL=

# Alpaca Data API credentials (required when market_data.provider = "alpaca")
# Sign up at https://alpaca.markets — the free tier includes real-time + 2yr history
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Legacy direct Robinhood auth env vars are intentionally omitted.
# Supported Robinhood flow is MCP/operator-managed snapshots plus local intent logs.
