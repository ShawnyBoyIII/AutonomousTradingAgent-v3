# Trading Bot Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# Paths
CONFIG_PATH=config.yaml
STATE_DB_PATH=state/trading_bot.db
LOG_LEVEL=INFO

# Optional alerts
DISCORD_WEBHOOK_URL=

# Alpaca Data API credentials (required when market_data.provider = "alpaca")
# Sign up at https://alpaca.markets — the free tier includes real-time + 2yr history
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Massive.com S3 flat-files (required when eod_data_store.enabled = true)
# Subscribed via https://massive.com — Stocks Starter minimum for day+minute aggregates
# End-of-day data populates state/data_store/ nightly for offline tuning and
# tuning-experiment replay. See docs/EOD_DATA_FEATURE.md.
MASSIVE_S3_ENDPOINT=
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_BUCKET=

# Legacy direct Robinhood auth env vars are intentionally omitted.
# Supported Robinhood flow is MCP/operator-managed snapshots plus local intent logs.
